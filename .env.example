# mitomap-link configuration (copy to .env). All vars use the MITOMAP_LINK_ prefix.
# Nested config uses a double underscore, e.g. MITOMAP_LINK_DATA__LOCAL_DATABASE.

# --- Server ---
# MITOMAP_LINK_HOST=127.0.0.1
# MITOMAP_LINK_PORT=8000
# MITOMAP_LINK_TRANSPORT=unified           # unified | http | stdio
# JSON lists. Add the exact public reverse-proxy hostname in production.
# MITOMAP_LINK_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
# MITOMAP_LINK_ALLOWED_ORIGINS=[]
# Browser deployments must also set MITOMAP_LINK_CORS_ORIGINS to the same origins;
# CORS response headers and request Origin validation are separate boundaries.
# MITOMAP_LINK_LOG_LEVEL=INFO
# MITOMAP_LINK_LOG_FORMAT=console          # console | json

# --- Data ---
# Production serves the pinned data release materialized under REFERENCE_ROOT by the
# init container. For development, serve a local SQLite (make dev-data) instead:
# MITOMAP_LINK_DATA__LOCAL_DATABASE=data/dev.sqlite
# MITOMAP_LINK_DATA__REFERENCE_ROOT=/data
